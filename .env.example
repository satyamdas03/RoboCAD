# RoboCAD local environment configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit secrets.

# Anthropic API key (optional if using a local Ollama model)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model selection (defaults to Claude 3.5 Sonnet if unset)
# ROBOCAD_MODEL=claude-3-5-sonnet-20241022
ROBOCAD_MODEL=qwen3-coder:latest

# Local Ollama / OpenAI-compatible endpoint (only used for local models)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Onshape API credentials (required for Onshape upload)
# Generate a key pair at: https://cad.onshape.com/appkey
ONSHAPE_ACCESS_KEY=your_onshape_access_key_here
ONSHAPE_SECRET_KEY=your_onshape_secret_key_here
ONSHAPE_BASE_URL=https://cad.onshape.com

# Optional: override CORS origins for the backend
# ROBOCAD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
